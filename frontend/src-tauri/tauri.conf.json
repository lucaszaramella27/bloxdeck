{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BloxDeck",
  "version": "0.1.0",
  "identifier": "com.bloxdeck.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BloxDeck",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3333 http://127.0.0.1:3333; img-src 'self' asset: data: https://images.unsplash.com https://tr.rbxcdn.com; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

